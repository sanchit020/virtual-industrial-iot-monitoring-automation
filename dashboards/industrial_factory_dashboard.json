    {
      "id": 4,
      "title": "Machine Temperatures vs Automation Thresholds (70°C Fan, 80°C Pump, 95°C Shutdown)",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "fillOpacity": 12,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 70
              },
              {
                "color": "#FF780A",
                "value": 80
              },
              {
                "color": "#F2495C",
                "value": 95
              }
            ]
          },
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max",
            "min"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "dfx5e82vpu680f"
          },
          "query": "from(bucket: \"industrial_iot\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r.sensor == \"temperature\")\n  |> filter(fn: (r) => r._value >= 0.0)\n  |> map(fn: (r) => ({\n      _time: r._time,\n      _value: r._value,\n      _field: if r.machine == \"machine1\" then \"Machine A\"\n              else if r.machine == \"machine2\" then \"Machine B\"\n              else if r.machine == \"machine3\" then \"Machine C\"\n              else r.machine\n  }))\n  |> group(columns: [\"_field\"])",
          "refId": "A"
        }
      ]
    },
