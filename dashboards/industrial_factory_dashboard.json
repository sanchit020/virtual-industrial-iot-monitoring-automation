    {
      "id": 1,
      "title": "Machine A Status",
      "type": "stat",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "displayName": "Machine A",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "RUNNING",
                  "color": "green"
                },
                "1": {
                  "text": "WARNING",
                  "color": "yellow"
                },
                "2": {
                  "text": "SHUTDOWN",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "dfx5e82vpu680f"
          },
          "query": "from(bucket: \"industrial_iot\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r.sensor == \"status\" and r.machine == \"machine1\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _value: r._value, _field: \"Status\"}))",
          "refId": "A"
        }
      ]
